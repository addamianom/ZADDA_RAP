
projection;
strict ( 2 );
use draft;

define behavior for ZC_ADDAH2 alias header
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _position { create; with draft; }
}

define behavior for ZC_ADDAP2 alias position
{
  use update;
  use delete;

  use association _Header { with draft; }
}